{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small"
  },
  "modules": [
    "title",
    "os",
    "uptime",
    {
      "type": "cpu",
      "showPeCoreCount": true,
      "temp": true
    },
    "memory",
    "disk",
    {
      "type": "battery",
      "temp": true
    },
    {
      "type": "command",
      "key": "Public IP",
      "text": "curl --fail --silent --show-error --max-time 5 https://ifconfig.co/json | jq --raw-output '[.ip, .city, .region_code, .country_iso] | .[0] + \" (\" + (.[1:] | map(select(. != null and . != \"\")) | join(\", \")) + \")\"'"
    },
    {
      "type": "localip",
      "showIpv6": true,
      "showLoop": true,
      "showAllIps": true
    },
    "terminal"
  ]
}
